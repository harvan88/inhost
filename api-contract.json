{
  "version": "1.0.0",
  "name": "INHOST API Contract",
  "description": "Contrato de integración entre frontend y backend - importa este archivo en tu frontend",
  "baseURL": {
    "development": "http://localhost:3000",
    "production": "https://api.inhost.com"
  },
  "websocketURL": {
    "development": "ws://localhost:3000/realtime",
    "production": "wss://api.inhost.com/realtime"
  },
  "headers": {
    "required": [
      {
        "name": "Content-Type",
        "value": "application/json",
        "description": "Requerido para POST/PUT/PATCH"
      },
      {
        "name": "X-User-Id",
        "value": "<userId>",
        "description": "Requerido para rate limiting. Obtener del auth context o storage"
      }
    ],
    "optional": [
      {
        "name": "Authorization",
        "value": "Bearer <token>",
        "description": "JWT token - REQUERIDO para endpoints /admin/*"
      }
    ]
  },
  "authentication": {
    "type": "JWT",
    "header": "Authorization: Bearer <token>",
    "tokenExpiry": "7 days",
    "refreshTokenExpiry": "30 days",
    "description": "Autenticación JWT implementada para endpoints admin"
  },
  "endpoints": {
    "health": {
      "method": "GET",
      "path": "/health",
      "description": "Verifica que el backend esté funcionando",
      "headers": [],
      "response": {
        "success": true,
        "data": {
          "status": "healthy",
          "database": "postgresql",
          "timestamp": "2025-11-18T12:00:00Z",
          "version": "1.0.0"
        }
      }
    },
    "sendMessage": {
      "method": "POST",
      "path": "/simulate/client-message",
      "description": "Envía un mensaje desde el chat (cliente web)",
      "headers": ["Content-Type", "X-User-Id"],
      "body": {
        "clientId": "web",
        "text": "string"
      },
      "response": {
        "success": true,
        "data": {
          "clientMessage": {
            "id": "uuid",
            "type": "incoming",
            "channel": "web",
            "text": "string",
            "persisted": true
          },
          "extensionResponses": [
            {
              "extensionId": "echo|ai|crm",
              "messageId": "uuid",
              "success": true,
              "status": "sent",
              "persisted": true
            }
          ],
          "processedCount": 2,
          "summary": {
            "clientMessagePersisted": true,
            "extensionResponsesSent": 2,
            "totalExtensions": 2
          }
        }
      },
      "errors": {
        "429": {
          "code": "RATE_LIMIT_EXCEEDED",
          "message": "Rate limit exceeded",
          "headers": {
            "X-RateLimit-Limit": "12",
            "X-RateLimit-Remaining": "0",
            "X-RateLimit-Reset": "1700308800",
            "Retry-After": "60"
          }
        },
        "400": {
          "code": "VALIDATION_ERROR",
          "message": "Validation failed",
          "details": "Field 'text' is required"
        }
      }
    },
    "getMessages": {
      "method": "GET",
      "path": "/messages",
      "description": "Obtiene los últimos mensajes",
      "headers": ["X-User-Id"],
      "query": {
        "limit": {
          "type": "number",
          "default": 10,
          "max": 100
        }
      },
      "response": {
        "success": true,
        "data": {
          "count": 10,
          "messages": [
            {
              "id": "uuid",
              "type": "incoming|outgoing",
              "channel": "web|whatsapp|telegram|sms",
              "content": {
                "text": "string"
              },
              "metadata": {
                "from": "string",
                "to": "string",
                "timestamp": "ISO8601"
              },
              "createdAt": "Date"
            }
          ],
          "storage": "postgresql"
        }
      }
    },
    "toggleExtension": {
      "method": "POST",
      "path": "/simulate/extension-toggle",
      "description": "Activa/desactiva una extensión (bot)",
      "headers": ["Content-Type"],
      "body": {
        "extensionId": "echo|ai|crm"
      },
      "response": {
        "success": true,
        "data": {
          "extensionId": "ai",
          "active": true
        }
      }
    },
    "getSimulationStatus": {
      "method": "GET",
      "path": "/simulate/status",
      "description": "Obtiene estado del sistema (extensiones, clientes)",
      "headers": [],
      "response": {
        "success": true,
        "data": {
          "clients": [
            {
              "id": "web-sim",
              "name": "Web Chat",
              "icon": "🌐",
              "channel": "web",
              "connected": true
            }
          ],
          "extensions": [
            {
              "id": "echo",
              "name": "Echo Bot",
              "icon": "📢",
              "active": false,
              "latency": 45,
              "subscriptions": ["incoming"]
            },
            {
              "id": "ai",
              "name": "AI Assistant",
              "icon": "🧠",
              "active": true,
              "latency": 120,
              "subscriptions": ["incoming"]
            },
            {
              "id": "crm",
              "name": "CRM Sync",
              "icon": "📊",
              "active": false,
              "latency": 200,
              "subscriptions": ["incoming"]
            }
          ],
          "stats": {
            "activeExtensions": 1,
            "connectedClients": 1,
            "totalClients": 4,
            "totalExtensions": 3
          }
        }
      }
    }
  },
  "adminEndpoints": {
    "auth": {
      "signup": {
        "method": "POST",
        "path": "/admin/auth/signup",
        "description": "Crear nueva cuenta de tenant con usuario owner",
        "headers": ["Content-Type"],
        "body": {
          "companyName": "string (2-255 chars)",
          "name": "string (2-255 chars)",
          "email": "string (email format)",
          "password": "string (min 8 chars, uppercase, lowercase, number)"
        },
        "response": {
          "success": true,
          "data": {
            "user": {
              "id": "uuid",
              "email": "user@example.com",
              "name": "John Doe",
              "role": "owner",
              "tenantId": "uuid",
              "tenantName": "My Company",
              "tenantSlug": "my-company"
            },
            "tokens": {
              "accessToken": "jwt-token",
              "refreshToken": "jwt-refresh-token",
              "expiresIn": 604800
            }
          }
        },
        "errors": {
          "409": "EMAIL_EXISTS or TENANT_EXISTS",
          "422": "VALIDATION_ERROR - weak password"
        }
      },
      "login": {
        "method": "POST",
        "path": "/admin/auth/login",
        "description": "Autenticarse con email y contraseña",
        "headers": ["Content-Type"],
        "body": {
          "email": "string (email format)",
          "password": "string"
        },
        "response": {
          "success": true,
          "data": {
            "user": {
              "id": "uuid",
              "email": "user@example.com",
              "name": "John Doe",
              "role": "owner|admin|agent|viewer",
              "tenantId": "uuid",
              "tenantName": "My Company",
              "tenantSlug": "my-company"
            },
            "tokens": {
              "accessToken": "jwt-token",
              "refreshToken": "jwt-refresh-token",
              "expiresIn": 604800
            }
          }
        },
        "errors": {
          "401": "INVALID_CREDENTIALS",
          "403": "ACCOUNT_DISABLED"
        }
      },
      "me": {
        "method": "GET",
        "path": "/admin/auth/me",
        "description": "Obtener información del usuario autenticado",
        "headers": ["Authorization"],
        "response": {
          "success": true,
          "data": {
            "id": "uuid",
            "email": "user@example.com",
            "name": "John Doe",
            "role": "owner|admin|agent|viewer",
            "isActive": true,
            "lastLoginAt": "ISO8601",
            "createdAt": "ISO8601",
            "tenant": {
              "id": "uuid",
              "name": "My Company",
              "slug": "my-company",
              "plan": "starter|professional|enterprise",
              "subscriptionStatus": "trialing|active|cancelled",
              "trialEndsAt": "ISO8601"
            }
          }
        },
        "errors": {
          "401": "UNAUTHORIZED or INVALID_TOKEN"
        }
      }
    },
    "tenant": {
      "get": {
        "method": "GET",
        "path": "/admin/tenant",
        "description": "Obtener información del tenant actual",
        "headers": ["Authorization"],
        "response": {
          "success": true,
          "data": {
            "id": "uuid",
            "name": "My Company",
            "slug": "my-company",
            "plan": "starter|professional|enterprise",
            "settings": {},
            "subscriptionStatus": "trialing|active|cancelled",
            "trialEndsAt": "ISO8601",
            "createdAt": "ISO8601"
          }
        }
      },
      "update": {
        "method": "PATCH",
        "path": "/admin/tenant",
        "description": "Actualizar tenant (owner/admin only)",
        "headers": ["Authorization", "Content-Type"],
        "requiredRoles": ["owner", "admin"],
        "body": {
          "name": "string (optional)",
          "settings": "object (optional)"
        },
        "response": {
          "success": true,
          "data": {
            "id": "uuid",
            "name": "Updated Company Name",
            "settings": {},
            "updatedAt": "ISO8601"
          }
        }
      },
      "stats": {
        "method": "GET",
        "path": "/admin/tenant/stats",
        "description": "Obtener estadísticas del tenant",
        "headers": ["Authorization"],
