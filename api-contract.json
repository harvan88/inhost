    "sync": {
      "initial": {
        "method": "GET",
        "path": "/admin/sync/initial",
        "description": "Initial data hydration after login (CRÍTICO)",
        "headers": ["Authorization"],
        "response": {
          "success": true,
          "data": {
            "conversations": "Conversation[] (últimas 50)",
            "contacts": "EndUser[] (todos los contactos)",
            "team": "TeamMember[] (miembros activos)",
            "integrations": "Integration[] (integraciones conectadas)"
