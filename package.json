{
  "name": "inhost",
  "version": "1.0.0",
  "description": "Inhost - Multiplatform Chat Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:*",
    "dev:api": "cd apps/api-gateway && bun --env-file=../../.env dev",
    "dev:db": "docker-compose up -d",
    "dev:db:stop": "docker-compose down",
    "build": "bun run build:*",
    "build:api": "bun --cwd apps/api-gateway build",
    "type-check": "bun --cwd apps/api-gateway type-check",
    "clean": "bun run clean:modules && bun run clean:build",
    "clean:modules": "rm -rf node_modules && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean:build": "find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate": "bun run scripts/migrate.ts",
    "test:whatsapp": "bun scripts/test-whatsapp-flow.ts",
    "test:messaging": "bun scripts/test-messaging-flow.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "deadcode:exports": "ts-prune",
    "deadcode:files": "unimported",
    "deadcode:deps": "depcheck",
    "deadcode:all": "bun run deadcode:exports && bun run deadcode:files"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.10",
    "depcheck": "^1.4.7",
    "drizzle-kit": "^0.31.6",
    "ts-prune": "^0.10.3",
    "typescript": "^5.0.0",
    "unimported": "^1.31.1"
  },
  "trustedDependencies": [
    "@elysiajs/cors",
    "@elysiajs/trpc",
    "drizzle-orm",
    "pg"
  ],
  "dependencies": {
    "@elysiajs/jwt": "^1.4.0",
    "drizzle-orm": "^0.44.7",
    "jose": "^6.1.2",
    "pg": "^8.16.3"
  }
}
