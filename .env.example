# INHOST Backend Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# CRITICAL: JWT Secret (REQUIRED)
# ============================================
# Generate a secure secret with:
# openssl rand -base64 64
#
# NEVER commit the actual .env file to git!
# NEVER use 'default' or 'secret' in production!
#
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long-replace-this

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inhost

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Rate Limiting Backend
# ============================================
# Options: 'memory' (default) or 'redis'
# Use 'redis' for production multi-instance deployments
RATE_LIMIT_BACKEND=memory

# ============================================
# Redis Configuration (if using Redis)
# ============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# Logging
# ============================================
# LOG_LEVEL=info
# LOG_FORMAT=json
