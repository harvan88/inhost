# ===================================
# INHOST API Gateway - Environment Configuration
# ===================================

# -----------------------
# Application Settings
# -----------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# -----------------------
# Redis Configuration (Sprint 4 - V2 Implementations)
# -----------------------
# Backend selector: "memory" (V1) or "redis" (V2)
RATE_LIMIT_BACKEND=memory

# Redis connection (only used if RATE_LIMIT_BACKEND=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------
# Database Configuration (Future - Sprint 4)
# -----------------------
# PostgreSQL connection for persistent storage
# DATABASE_URL=postgresql://user:password@localhost:5432/inhost

# -----------------------
# Rate Limiting Configuration
# -----------------------
# Limits are defined in code by plan (Free: 12/min, Premium: 30/min)
# Backend selection above determines implementation (memory vs redis)

# -----------------------
# Adapter Configuration
# -----------------------
# Currently using simulated adapters (Sprint 1)
# Production adapters will be added in future sprints
